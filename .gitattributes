# Normalize all text files to LF in repo AND working tree.
# eol=lf overrides core.autocrlf so CRLF warnings disappear cross-platform.
* text=auto eol=lf

# Explicit binary types (never touch line endings, never diff as text)
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary

# Shell scripts must be LF (some are already)
*.sh text eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
